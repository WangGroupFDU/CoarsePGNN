+    def test_accepted_review_revalidation_restores_action_without_recommit(self):
+        """已接受回复可按原字节重新校验，恢复决定但不改R或重复发送。"""
+        self.reviewed(decision="REVISE")
+        review_sha = self.state["review_sha"]
+        self.state["phase"] = "REVIEWING"
+        with patch.object(loop, "archive_review") as export:
+            loop.accept_review(self.root, self.state)
+        export.assert_not_called()
+        self.assertEqual(self.state["phase"], "ACTION_READY")
+        self.assertEqual(self.state["review_sha"], review_sha)
+        self.state["request"]["control"]["decision"] = "PASS"
+        with self.assertRaisesRegex(ValueError, "控制对象"):
+            loop.accept_review(self.root, self.state)
+
+    def test_remote_verification_preserves_accepted_revise(self):
+        """真实Git对象配合假GitHub，确认推送R核验不会清除下一轮授权。"""
+        import base64
+        self.reviewed(decision="REVISE")
+        head = git(self.project, "rev-parse", "HEAD")
+        artifact = self.state["artifact_sha"]
+        def remote(argv):
+            """仅响应本测试三个GitHub只读端点，其他调用立即失败。"""
+            endpoint = argv[-1]
+            if "/git/ref/" in endpoint:
+                return json.dumps({"object":{"sha":head}})
+            if "/git/commits/" in endpoint:
+                sha = endpoint.rsplit("/",1)[1]
+                return json.dumps({"sha":sha,"tree":{"sha":git(self.project,"rev-parse",sha+"^{tree}")}})
+            if "/contents/" in endpoint:
+                path = self.state["manifest_path"]
+                return json.dumps({"sha":git(self.project,"rev-parse",artifact+":"+path),"encoding":"base64",
+                    "content":base64.b64encode((self.project/path).read_bytes()).decode()})
+            raise AssertionError(argv)
+        with patch.object(loop, "execute", side_effect=remote):
+            loop.verify_remote(self.root,self.state)
+        self.assertEqual(self.state["phase"],"ACTION_READY")
+
